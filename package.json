{
  "name": "personal-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:node": "node --test core/db.test.ts agent/tools.test.ts agent/loop.test.ts",
    "test:all": "npm run typecheck:node && npm run test:node && npm run build && npm run test"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
